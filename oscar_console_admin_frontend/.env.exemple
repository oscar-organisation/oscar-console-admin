# Les réglages de l'interface de la console d'administration, pour le poste du
# développeur. Aucune valeur de test ni de production ici.
#
# COMMENT S'EN SERVIR
#
#     cp .env.exemple .env
#
# Le fichier .env se place à côté de compose.yaml, dans ce même dossier: c'est
# là que « docker compose » le cherche. Les valeurs ci-dessous font parler
# l'interface du poste (18200) à l'API du poste (18202).
#
# CES RÉGLAGES SONT PUBLICS
#
# Le serveur web les écrit au démarrage dans runtime-config.js, que tout
# navigateur peut lire: aucun secret n'a sa place ici. En test et en
# production, ils sont posés sur l'application Coolify par l'assistant de
# déploiement.
#
# CE FICHIER EST LA LISTE COMPLÈTE
#
# Chaque variable lue par compose.yaml ou compose.override.yaml est expliquée
# ici, et seulement celles-là: les vérifications automatiques de GitHub
# comparent les deux listes.


# ---------------------------------------------------------------------------
# Le déploiement
# ---------------------------------------------------------------------------

# Le nom du déploiement: il préfixe le conteneur et le réseau.
# Défaut: console-admin-interface.
OSCAR_NOM_DU_DEPLOIEMENT=console-admin-interface

# L'entrepôt d'images (Harbor) et l'étiquette de l'image à lancer. En local,
# l'image se construit sur le poste sous l'étiquette par défaut. En test et en
# production, le déploiement automatique pose l'étiquette lui-même. Elle sert
# aussi de version dans les journaux d'erreurs de l'application.
ADRESSE_ENTREPOT_IMAGES=registry-container.oscar-bot.com
ETIQUETTE_IMAGE_A_METTRE_EN_LIGNE=construite-sur-le-poste-du-developpeur

# Le port du poste, sur la boucle locale 127.0.0.1 seulement. Défaut: 18200.
OSCAR_PORT_PUBLIE_INTERFACE=18200


# ---------------------------------------------------------------------------
# Les adresses
# ---------------------------------------------------------------------------

# L'adresse de l'API, préfixe /api compris, telle que le navigateur la joint.
# Sans elle, l'application refuse de démarrer et le dit à l'écran.
# En test: https://test-api-console.oscar-bot.com/api.
OSCAR_API_BASE_URL=http://127.0.0.1:18202/api

# L'adresse complète du cockpit XR, servi par ce même serveur sous /xr/.
# En test: https://test-console.oscar-bot.com/xr/.
OSCAR_COCKPIT_URL=http://127.0.0.1:18200/xr/


# ---------------------------------------------------------------------------
# L'affichage
# ---------------------------------------------------------------------------

# local, test ou production: dit dans les journaux d'erreurs.
OSCAR_ENVIRONMENT=local

# Le chemin de base de l'application, le nom affiché, le nom court, le thème
# par défaut (dark, light ou system), le délai d'attente de l'API en
# millisecondes, et l'adresse de support proposée à l'écran.
OSCAR_BASE_PATH=/
OSCAR_APPLICATION_NAME=OSCAR Control Plane
OSCAR_SHORT_NAME=OSCAR
OSCAR_DEFAULT_THEME=dark
OSCAR_API_TIMEOUT_MS=15000
OSCAR_SUPPORT_EMAIL=support@oscar-bot.com
