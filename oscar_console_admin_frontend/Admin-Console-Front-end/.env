# Fichier d'environnement pour le DEPLOIEMENT du frontend (docker-compose.yml).
# Copier en .env avant "docker compose up -d --build".
#
# URL de l'API Centrale, figee au build de la SPA (arg VITE_API_URL).
# Doit pointer vers le domaine API expose par le proxy central.
VITE_API_URL=https://api-admin.oscar-bot.com/api

VITE_COCKPIT_URL=https://admin-console.oscar-bot.com/xr/
