# Les réglages de l'API de la console d'administration, pour le poste du
# développeur. Aucune valeur de test ni de production ici.
#
# COMMENT S'EN SERVIR
#
#     cp .env.exemple .env
#
# Le fichier .env se place à côté de compose.yaml, dans ce même dossier: c'est
# là que « docker compose » le cherche. Les valeurs ci-dessous suffisent pour
# lancer l'API et sa base sur le poste.
#
# EN TEST ET EN PRODUCTION
#
# Ce fichier ne sert pas: chaque variable est posée sur l'application Coolify
# par l'assistant de déploiement, et les secrets viennent de secret_root/, un
# jeu par environnement. Une valeur de test ou de production n'entre jamais
# dans ce dépôt.
#
# CE FICHIER EST LA LISTE COMPLÈTE
#
# Chaque variable lue par compose.yaml ou compose.override.yaml est expliquée
# ici, et seulement celles-là: les vérifications automatiques de GitHub
# comparent les deux listes. Les autres réglages de l'API (durées des jetons,
# Keycloak, et cetera) gardent la valeur du code, dans app/config.py.


# ---------------------------------------------------------------------------
# Le déploiement
# ---------------------------------------------------------------------------

# Le nom du déploiement: il préfixe les conteneurs, le réseau et les volumes.
# Défaut: console-admin-api.
OSCAR_NOM_DU_DEPLOIEMENT=console-admin-api

# L'entrepôt d'images (Harbor) et l'étiquette de l'image à lancer. En local,
# l'image se construit sur le poste sous l'étiquette par défaut, qui n'existe
# pas dans l'entrepôt. En test et en production, le déploiement automatique
# pose l'étiquette lui-même: ne la changez à la main que pour revenir en
# arrière.
ADRESSE_ENTREPOT_IMAGES=registry-container.oscar-bot.com
ETIQUETTE_IMAGE_A_METTRE_EN_LIGNE=construite-sur-le-poste-du-developpeur

# Les ports du poste, sur la boucle locale 127.0.0.1 seulement.
# Défauts: 18202 pour l'API, 18203 pour la base.
OSCAR_PORT_PUBLIE_API=18202
OSCAR_PORT_PUBLIE_BASE_DE_DONNEES=18203


# ---------------------------------------------------------------------------
# La base de données
# ---------------------------------------------------------------------------

# Le compte, le mot de passe et le nom de la base. La base les reçoit à sa
# première initialisation; l'API les reçoit dans son adresse de connexion.
# Le mot de passe entre tel quel dans cette adresse: n'y mettez que des
# lettres, des chiffres et des tirets. Changer le mot de passe ici ne change
# pas celui d'une base déjà initialisée.
POSTGRES_USER=oscar
POSTGRES_PASSWORD=mot-de-passe-de-la-base-du-poste
POSTGRES_DB=oscar_admin


# ---------------------------------------------------------------------------
# La connexion à la console
# ---------------------------------------------------------------------------

# La clé qui signe les jetons de connexion. Secret en test et en production.
SECRET_KEY=cle-de-signature-des-jetons-du-poste-jamais-reprise-en-test

# Les adresses de l'interface autorisées à appeler l'API depuis un navigateur,
# séparées par des virgules. En local, l'interface répond sur 18200.
CORS_ORIGINS=http://127.0.0.1:18200,http://localhost:18200

# L'adresse publique de l'interface, pour les liens des courriels. Si le
# courriel est réglé (SMTP_HOST), l'API refuse de démarrer quand cette adresse
# vise le poste.
PUBLIC_APP_URL=http://127.0.0.1:18200

# Le mode de connexion. legacy: la connexion propre à la console, la seule en
# service. Keycloak n'est pas branché sur les routes.
AUTH_MODE=legacy

# L'administrateur créé au premier démarrage, seulement s'il n'existe pas.
# Changer ces valeurs ensuite ne change pas un compte déjà créé.
ADMIN_EMAIL=admin@oscar.fr
ADMIN_PASSWORD=mot-de-passe-administrateur-du-poste
ADMIN_NAME=Super Admin

# Les données de démonstration: organisations, sites, robots et comptes
# fictifs, utiles sur le poste. Défaut de la composition: false (éteintes en
# test et en production).
SEED_DEMO=true


# ---------------------------------------------------------------------------
# LiveKit, le serveur temps réel des robots et du cockpit
# ---------------------------------------------------------------------------

# L'adresse donnée au navigateur et au robot (wss://... en test et en
# production), l'adresse de l'API de LiveKit vue depuis l'API de la console, et
# la clé et le secret qui signent les jetons des sessions. Aucun LiveKit ne
# tourne sur le poste: les écrans des robots le disent injoignable.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_HOST_URL=http://localhost:7880
LIVEKIT_API_KEY=cle-livekit-du-poste
LIVEKIT_API_SECRET=secret-livekit-du-poste-jamais-repris-en-test


# ---------------------------------------------------------------------------
# Le courriel sortant
# ---------------------------------------------------------------------------

# Vide: rien n'est envoyé, chaque message est écrit dans le journal de l'API.
# 465 pour une connexion chiffrée d'emblée, 587 pour STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=OSCAR Control Plane


# ---------------------------------------------------------------------------
# Les machines qui appellent l'API, et les fichiers déposés
# ---------------------------------------------------------------------------

# Les clés du service de perception et du runtime embarqué des robots (la clé
# de flotte, acceptée d'un robot qui n'a pas encore la clé de sa machine).
# Vides: leurs appels sont refusés (503). Secrets en test et en production.
PERCEPTION_WORKER_API_KEY=
EDGE_RUNTIME_API_KEY=
# L'ancien nom de la clé de flotte, du temps de « l'agent embarqué ». Lu
# seulement quand EDGE_RUNTIME_API_KEY est vide. Laissez-le vide: il disparaîtra.
EDGE_AGENT_API_KEY=

# La taille la plus grande, en mégaoctets, d'un modèle d'IA et d'un paquet
# embarqué déposés dans la console.
MODEL_MAX_UPLOAD_MB=512
EDGE_RELEASE_MAX_MB=64
